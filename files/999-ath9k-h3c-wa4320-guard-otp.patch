+		dev_err(ah->dev, "wa4320-dc: skipping OTP MMIO; no usable calibration\n");
+		kfree(word);
+		return -EIO;
+	}
+
 	read = ar9300_read_otp;
 	cptr = AR9300_BASE_ADDR;
 	ath_dbg(common, EEPROM, "Trying OTP access at Address 0x%04x\n", cptr);
